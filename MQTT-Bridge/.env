# ============================================
# MQTT Bridge - Konfigurasi Environment
# Setiap service memiliki database sendiri
# ============================================

# --- MQTT Broker ---
# IP komputer yang menjalankan Mosquitto
# Gunakan 127.0.0.1 jika MQTT-Bridge dan Mosquitto ada di komputer yang sama
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_ID=mqtt-bridge-pasien-ta-pbl

# --- MySQL Database (Host & Credentials) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=

# --- Database per Service ---
# GPS-Service (Bn220) memakai database db_gps
DB_GPS_NAME=db_gps

# MPU-Service memakai database db_mpu
DB_MPU_NAME=db_mpu

# --- Bridge Settings ---
# Port untuk health check endpoint (opsional)
BRIDGE_PORT=3001
